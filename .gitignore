# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Go coverage output
*.out
coverage.out
coverage.html

# Build output
bin/
dist/stage/
dist/out/
dist/plugins/
tmp/

# Stray top-level binaries from `go build` / `go run`
/opskeeper
/opskeeper-frontier
/opskeeper-edge
/opskeeper-eval

# release artifacts
dist/stage/
dist/out/
bin/linux-*
bin/darwin-*
bin/windows-*

# Dependencies
# Keep Go-vendored deps (if any) ignored, but allow the Pi vendor submodule
# so plan1.0.md P-1 (`vendor/pi` at tag v0.85.1) can be checked in.
vendor/*
!vendor/
!vendor/pi
!vendor/pi/**

# Go workspace file
go.work
go.work.sum

# Env files — keep .env.example
.env
.env.*
!.env.example

# Local-only config overrides
*.local.yaml
*.local.yml

# Editor / OS
.idea/
.vscode/
.DS_Store

# Claude Code transient files
.claude/
web/dist/
web/node_modules/
web/tsconfig.tsbuildinfo

# Local dev artifacts (deploy/)
deploy/docker-compose.override.yml
deploy/certs/
deploy/install/certs/
/local/

# build cache: stack-dep upstream binaries fetched by dist/package.sh
.cache/
/builder-cache/
docs/integration/ppt-build/node_modules/
# Plugin dashboard builds (generated by `npm run build`)
plugins/*/dashboard/dist/
plugins/*/dashboard/node_modules/
plugins/*/dist/

# Codex CLI local artifacts (hooks, plugin cache) — never in repo
.codex/

# Agent skills cache (per-repo)
/.agents/

# Playwright MCP transient logs
.playwright-mcp/

# Stray top-level screenshots / OCR scratch from one-off runs
/*.png
!cmd/**/*.png
!docs/**/*.png
!plugins/**/*.png
!web/**/*.png

# Built plugin adapter zips (dist/adapters/qwenpaw/*.zip)
dist/adapters/

# Local removed/ scratch backups (never commit)
.removed/
*.removed
*.removed/
__pycache__/
*.pyc
plugins/opskeeper-teamharness/eval/reports/
/data/
*.db
*.db-shm
*.db-wal
